<Window x:Class="WenMind.Daily.QuoteCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="WenMind 每日一言" Width="426" MaxHeight="500" SizeToContent="Height" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource Action}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
            CornerRadius="12" Padding="22,15,22,17">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True" Margin="0,0,0,10">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Padding="7,2" FontSize="19" Content="×"
                        Background="Transparent" AutomationProperties.Name="关闭" ToolTip="关闭" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Accent}" Width="3" Height="12" Margin="0,0,8,0" CornerRadius="1" />
                    <TextBlock x:Name="Heading" Text="今日一言" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="315" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="FullText" FontFamily="SimSun, Microsoft YaHei UI, Segoe UI" FontSize="23"
                               FontWeight="SemiBold" LineHeight="34" TextWrapping="Wrap" Foreground="{DynamicResource Text}" />
                    <TextBlock x:Name="Attribution" FontSize="13" TextWrapping="Wrap" Margin="0,9,0,0"
                               Foreground="{DynamicResource Secondary}" />
                    <TextBlock x:Name="Provider" FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource Secondary}" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NextButton" Content="换一句" Margin="0,0,7,0"
                        AutomationProperties.Name="换一句" />
                <Button x:Name="CopyButton" Content="复制" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
