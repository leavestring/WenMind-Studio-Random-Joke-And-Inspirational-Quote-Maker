<Window x:Class="WenMind.Daily.RefreshSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="WenMind 设置" Width="374" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource Card}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="自动刷新名言" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
        <RadioButton x:Name="DailyMode" GroupName="RefreshMode" Content="每天一次（跨日时更新）"
                     Foreground="{DynamicResource Text}" Margin="0,0,0,10" />
        <RadioButton x:Name="IntervalMode" GroupName="RefreshMode" Content="固定间隔"
                     Foreground="{DynamicResource Text}" Margin="0,0,0,7" />
        <StackPanel Orientation="Horizontal" Margin="20,0,0,0"
                    IsEnabled="{Binding IsChecked, ElementName=IntervalMode}">
            <TextBlock Text="每隔" VerticalAlignment="Center" />
            <TextBox x:Name="MinutesInput" Width="65" Padding="5,4" Margin="7,0"
                     Background="{DynamicResource Action}" Foreground="{DynamicResource Text}"
                     CaretBrush="{DynamicResource Text}" BorderBrush="{DynamicResource Divider}"
                     AutomationProperties.Name="刷新间隔（分钟）" />
            <TextBlock Text="分钟刷新" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="Message" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Accent}" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="68" Padding="0,5" Margin="0,0,8,0"
                    Background="{DynamicResource Card}" Foreground="{DynamicResource Text}"
                    BorderBrush="{DynamicResource Divider}" />
            <Button x:Name="SaveButton" Content="保存" Width="68" Padding="0,5" IsDefault="True"
                    Background="{DynamicResource Action}" Foreground="{DynamicResource Accent}"
                    BorderBrush="{DynamicResource Divider}" />
        </StackPanel>
    </StackPanel>
</Window>
