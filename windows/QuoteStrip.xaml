<Window x:Class="WenMind.Daily.QuoteStrip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="WenMind 任务栏一言" Width="286" Height="34" MinWidth="0" MinHeight="0"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True">
    <Button x:Name="QuoteButton" Focusable="False" Padding="8,0" Cursor="Hand"
            AutomationProperties.Name="查看今日一言" ToolTip="查看今日一言">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="#01000000">
                    <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Margin="0,0,7,0" Width="11" Height="9" Stretch="Uniform" VerticalAlignment="Center"
                  Fill="{DynamicResource Accent}"
                  Data="M0,9 C0,4 2,1 5,0 L5,2 C3,3 3,4 3,5 L5,5 L5,9 Z M7,9 C7,4 9,1 12,0 L12,2 C10,3 10,4 10,5 L12,5 L12,9 Z" />
            <TextBlock x:Name="Excerpt" Grid.Column="1" FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}"
                       VerticalAlignment="Center" />
        </Grid>
    </Button>
</Window>
